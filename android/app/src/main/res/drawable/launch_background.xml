<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de carga nativa: fondo de marca + logotipo.
     Se pinta desde el arranque del proceso (antes del primer frame de Flutter),
     así que el usuario ve el logo de inmediato en vez de una pantalla negra. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
